        function checkPassword() {
            var rules = [{
                Pattern: "[A-Z]",
                Target: "UpperCase"
            },
            {
                Pattern: "[a-z]",
                Target: "LowerCase"
            },
            {
                Pattern: "[0-9]",
                Target: "Numbers"
            },
            {
                Pattern: "[!@@#$%^&*~)(|,<.>/?]",
                Target: "Symbols"
            }
            ];

            var password = $(this).val();

            var isValidLength = password.length > 7;

            var $icon = $("#Length").find("svg");
            $icon.removeClass(isValidLength ? "bg-lightblue" : "bg-lightgreen");
            $icon.addClass(isValidLength ? "bg-lightgreen" : "bg-lightblue");

            for (var i = 0; i < rules.length; i++) {
                var isValid = new RegExp(rules[i].Pattern).test(password);
                var $icon = $("#" + rules[i].Target).find("svg");
                if (isValid) {
                    $icon.removeClass("bg-lightblue").addClass("bg-lightgreen");
                } else {
                    $icon.removeClass("bg-lightgreen").addClass("bg-lightblue");
                }
            }
        }



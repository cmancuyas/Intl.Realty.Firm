                                <span asp-validation-for="CreatedBy" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.FinalSalePrice" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.FinalSalePrice" class="form-control" value="1" />
                                <span asp-validation-for="CreateIRFDealViewModel.FinalSalePrice" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.FinalClosingDate" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.FinalClosingDate" class="form-control" />
                                <span asp-validation-for="CreateIRFDealViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.DepositAmount" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.DepositAmount" class="form-control" value="1" />
                                <span asp-validation-for="CreateIRFDealViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.DepositDate" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.DepositDate" class="form-control" />
                                <span asp-validation-for="CreateIRFDealViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyerName" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyerName" class="form-control" value="BuyerName" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.LandLordName" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.LandLordName" class="form-control" value="LandLordName" />
                                <span asp-validation-for="CreateIRFDealViewModel.LandLordName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.ListingCommissionPercentage" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.ListingCommissionPercentage" class="form-control" value="1" />
                                <span asp-validation-for="CreateIRFDealViewModel.ListingCommissionPercentage" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyingCommissionPercentage" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyingCommissionPercentage" class="form-control" value="1" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyingCommissionPercentage" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.ListingAgentName" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.ListingAgentName" class="form-control" value="ListingAgentName" />
                                <span asp-validation-for="CreateIRFDealViewModel.ListingAgentName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.ListingBrokerage" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.ListingBrokerage" class="form-control" value="ListingBrokerage" />
                                <span asp-validation-for="CreateIRFDealViewModel.ListingBrokerage" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.ListingBrokerageFax" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.ListingBrokerageFax" class="form-control" value="ListingBrokerageFax" />
                                <span asp-validation-for="CreateIRFDealViewModel.ListingBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyerAgentName" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyerAgentName" class="form-control" value="BuyerAgentName" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerAgentName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyerBrokerage" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyerBrokerage" class="form-control" value="BuyerBrokerage" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerBrokerage" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="form-control" value="BuyerBrokerageFax" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersLawyer" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersLawyer" class="form-control" value="SellersLawyer" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersLawyer" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersLawyerAddress" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersLawyerAddress" class="form-control" value="SellersLawyerAddress" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersLawyerAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersPhoneNumber" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersPhoneNumber" class="form-control" value="SellersPhoneNumber" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersLawyer" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersLawyer" class="form-control" value="BuyersLawyer" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersLawyer" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="form-control" value="BuyersLawyerAddress" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="control-label"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="form-control" value="BuyersPhoneNumber" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>


                </div>
            </div>

            <div class="form-submit-tab p-4">
                <hr />
                <div class="row d-flex justify-content-center m-0">
                    <div class="col-md-12">
                        <h5 class="text-blue mb-4">Please match your uploaded file based on the Document Type for Sale Listing.<span class="s-required">*</span></h5>
                        <table class="table dataTable" id="tblApplicantFiles" width="100%">
                            <thead>
                                <tr>
                                    <th style="width: 30%">Document Type</th>
                                    <th>Is Required?</th>
                                    <th>Uploaded Document</th>

                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 0;
                                }
                                @foreach (DocumentType item in Model.DocumentTypeList)
                                {
                                    <tr>
                                        <td style="width: 30%">
                                            @Html.DisplayFor(modelItem => item.Description)
                                        </td>
                                        <input type="hidden"
                                               asp-for="CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].DocumentTypeId"
                                               value="@item.Id" />
                                        <td id="isRequired">
                                            @if (item.IsRequired == true)
                                            {
                                                <label class="status-active">Required</label>
                                            }
                                            else if (item.IsRequired == false)
                                            {
                                                <label class="status-inactive pe-cursor">Not Required</label>
                                            }
                                        </td>
                                        <td>
                                            <input asp-for="CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].Files"
                                                   id="fileListDropDown_@i"
                                                   type="file"
                                                   class="file"
                                                   multiple
                                                   data-show-upload="false"
                                                   data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                   accept="application/all"
                                                   data-show-caption="true"
                                                   data-show-preview="false"
                                                   onchange="fileSelected(this)"
                                                   data-msg-placeholder="Select {files} for upload...">
                                        </td>
                                        @{
                                            i++;
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <hr class="my-5" />

            <div class="form-group d-flex justify-content-center gap-4">
                <button type="button" id="prevBtn" class="btn btn-secondary scroll-top w-25" onclick="nextPrev(-1)">Back</button>
                <button type="button" id="nextBtn" class="btn btn-primary w-25 btn-next scroll-top" onclick="nextPrev(1)">Next</button>
                <button type="button" id="btnSubmit" class="btn btn-primary w-25 btn-submit scroll-top">Submit</button>
            </div>
        </div>
    </form>

</div>

<script type="text/javascript">
    $(document).ready(function () {

        onBtnSubmit();

        confirmSubmitModal();


    }); // document.ready

    function onBtnSubmit() {
        const saleListingForm = document.getElementById('SaleListingForm');
        $("#btnSubmit").click(function () {

            var documentTypeListSerialized = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DocumentTypeList))';
            var documentTypeList = JSON.parse(documentTypeListSerialized);
            var openModalFlag = true;
            documentTypeList.forEach(function (item, index) {

                var formFiles = document.forms['SaleListingForm']['CreateFileUploadListViewModel.CreateFileUploadsViewModel[' + index + '].Files'];
                if (item.IsRequired == true && formFiles.value != "") {
                    // Do nothing
                } else if (item.IsRequired != true && formFiles.value == "") {
                    // Do nothing
                } else {
                    var title = item.Description + " is required.";
                    Swal.fire({
                        title: title,
                        text: "Please upload the required documents to proceed with the application.",
                        icon: "error",
                        confirmButtonColor: '#203D57'
                    });

                    openModalFlag = false;
                }

            })
            //Check if required fields are filled up
            if (openModalFlag == true) {
                $("#confirmSubmitModal").modal("show");
            }

        });
    }

    function confirmSubmitModal() {
        const saleListingForm = document.getElementById('SaleListingForm');
        $("#btnConfirmSubmit").click(function () {
            $("#confirmSubmitModal").modal("hide");
            saleListingForm.submit();
            // CreateFileUpload();
        });
    }

    function fileSelected(that) {
        var curval = that.dataset.curval;
        var id = that.id;
        document.getElementById(that.id).setAttribute("data-prevVal", curval);
        document.getElementById(that.id).setAttribute("data-curVal", that.value);
    }

    var currentTab = 0;
    showTab(currentTab);

    function showTab(n) {
        $(".form-submit-tab").hide();
        $(".form-submit-tab").eq(n).show();

        $(".form-submit-step").removeClass("active");

        switch (n) {
            case 0:
                $(".form-submit-step").eq(0).addClass("active");
                $(".btn-next").show();
                $(".btn-submit").hide();
                break;
            case 1:
                $(".form-submit-step").eq(1).addClass("active");
                $(".btn-next").hide();
                $(".btn-submit").show();
                break;
        }

        $("#prevBtn").toggle(n !== 0);
    }
    function nextPrev(n) {
        var x = $(".form-submit-tab");

        x.eq(currentTab).hide();
        currentTab += n;

        if (currentTab >= x.length) {
            $(".form-submit-step").removeClass("active");
            $(".form-submit-step").eq(3).addClass("active");
            return false;
        }

        showTab(currentTab);
    }

</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("~/Shared/_ValidationScriptsPartial.cshtml");
    }
}

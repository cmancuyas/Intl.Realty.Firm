        function validateFields() {

            var firstInvalidField = null;

            var fields = [
                { id: "#firstname", dataValidationFor: "FirstName", errorMessage: "First Name is Required" },
                { id: "#lastname", dataValidationFor: "LastName", errorMessage: "Last Name is Required" },
                { id: "#birthdate", dataValidationFor: "BirthDate", errorMessage: "Birth Date is Required" },
                { id: "#contactnumber", dataValidationFor: "ContactNo", errorMessage: "Contact Number is Required" },
                { id: "#office", dataValidationFor: "OfficeId", errorMessage: "Office Name is Required" },
                { id: "#employmentdate", dataValidationFor: "EmploymentDate", errorMessage: "Date of Employment is Required" },
                { id: "#employmentstatus", dataValidationFor: "EmployeeStatus", errorMessage: "Employment Status is Required" },
                { id: "#systemrole", dataValidationFor: "RoleId", errorMessage: "System Role is Required" },
                { id: "#educationalAttainment", dataValidationFor: "EducAttainment", errorMessage: "Educational Attainment is Required" },
                { id: "#areaofexpertise", dataValidationFor: "FieldOfExpertise", errorMessage: "Area of Expertise is Required" }
            ];

            fields.forEach(function (field) {
                var value = $(field.id).val().trim();
                if (!value) {
                    $(field.id).addClass("border border-danger");
                    $('[data-validation-for="' + field.dataValidationFor + '"]').text(field.errorMessage);

                    // Store the first invalid field
                    if (!firstInvalidField) {
                        firstInvalidField = field.id;
                    }

                } else {
                    $(field.id).removeClass("border border-danger");
                    $('[data-validation-for="' + field.dataValidationFor + '"]').text("");
                    if (field.validate && !field.validate(value)) {
                    }
                }
            });

            // Scroll to the first invalid field
            if (firstInvalidField) {                
                ScrollInvalidElement(firstInvalidField);
            }

        }

        // function to scroll the invalid element 
        function ScrollInvalidElement(firstInvalidField) {
            var mainElement = document.querySelector('main'); // Select your main element

            // Get the target element within main
            var targetElement = $(firstInvalidField)[0];

            // Calculate the scroll position relative to main
            var offsetTop = targetElement.offsetTop - mainElement.offsetTop;
            var offsetLeft = targetElement.offsetLeft - mainElement.offsetLeft;

            // Scroll main element to the calculated position
            mainElement.scrollTo({
                top: offsetTop,
                left: offsetLeft,
                behavior: 'smooth'
            });
        }


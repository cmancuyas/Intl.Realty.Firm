                    type: 'GET',
                    data: { divisionId: divisionId },
                    success: function (data) {
                        var sectionSelect = $('#section');
                        sectionSelect.empty();
                        sectionSelect.prepend('<option value="0">Select Section (Optional)</option>');
                        sectionSelect.append('<option value="0">N/A</option>');

                        $.each(data, function (index, item) {
                            sectionSelect.append('<option value="' + item.id + '">' + item.description + '</option>');
                        });

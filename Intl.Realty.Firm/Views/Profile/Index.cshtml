        $(document).on('click', '#preConfirmationOkBtn', function () {
            var formId = "EditProfileForm";//this.dataset.formid;
            var action = "Edit";//this.dataset.action;
            var editBtnID = "EditBtn";//this.dataset.editbtnid;
            var partialContainer = "PartialContainerForEdit";//this.dataset.partialcontainer;
            var token = $('#' + formId).find('input[name="__RequestVerificationToken"]').val(); // Retrieve token from this form
            $("#" + partialContainer + " :input").removeClass("border border-danger");
            $(".validation-message-for-edit").html("");
            $.ajax({
                url: '/Profile/' + action,
                type: 'POST',
                data: $('#' + formId).serialize(),
                headers: {
                    'RequestVerificationToken': token  // Add the token to the headers
                },
                success: function (response) {
                    if (response.success) {
                        $("#SuccessOrFailedModalMessage").html(response.message);
                        $("#isSubmissionSuccess").html('Success!');
                        $('#successOrFailedModal').modal('show');
                        IconForSuccessOrFailedModal(true)
                        $('#' + editBtnID).show();
                        //$('#' + partialContainer + ' div').empty();
                        $('#' + partialContainer + ' div').load('/Profile/Edit?editable=false', function (data) { });
                        UpdateTopRightProfileInfo();
                    } else {
                        $("#isSubmissionSuccess").html('Failed!');
                        $("#SuccessOrFailedModalMessage").html(response.message);
                        $('#successOrFailedModal').modal('show');
                        IconForSuccessOrFailedModal(false)
                        if (response.invalidFields != null) {
                            var invalidKey = response.invalidFields;
                            var fieldsWithErrors = response.fieldsWithErrorMsg;
                            var firstInvalidFieldId = null
                            for (let i = 0; i < fieldsWithErrors.length; i++) {
                                $("[name='" + fieldsWithErrors[i].key + "']").addClass("border border-danger");
                                $("[data-validation-for='" + fieldsWithErrors[i].key + "']").html(fieldsWithErrors[i].error);
                                if (firstInvalidFieldId == null) { 

                                <input asp-for="CreateIRFDealViewModel.BuyerBrokerage" class="form-control" value="BuyerBrokerage" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerBrokerage" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="form-control" value="BuyerBrokerageFax" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyerBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersLawyer" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersLawyer" class="form-control" value="SellersLawyer" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersLawyer" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersLawyerAddress" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersLawyerAddress" class="form-control" value="SellersLawyerAddress" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersLawyerAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.SellersPhoneNumber" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.SellersPhoneNumber" class="form-control" value="SellersPhoneNumber" />
                                <span asp-validation-for="CreateIRFDealViewModel.SellersPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersLawyer" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersLawyer" class="form-control" value="BuyersLawyer" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersLawyer" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="form-control" value="BuyersLawyerAddress" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersLawyerAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="control-label fw-bolder"></label>
                                <input asp-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="form-control" value="BuyersPhoneNumber" />
                                <span asp-validation-for="CreateIRFDealViewModel.BuyersPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>


                </div>
            </div>

            <div class="form-submit-tab mt-4">
                <div class="row m-0 mb-4">
                    <div class="col-md-12">
                        <div class="mb-4">
                            <span class="c-preline" style="white-space: pre-line">@ViewBag.RequiredDocsList</span>
                        </div>
                        <div class="gap-4 mb-5">
                            <h2 class="text-secondary fw-bold m-0">Attach Required Documents<span class="s-required">*</span></h2>
                            <div class="alert alert-warning mt-3 mb-3" role="alert">
                                <ul style="margin-bottom: 0px;">
                                    <li>When uploading multiple files, drag all files at once on the field.</li>
                                    <li>Only alphanumeric characters (A-Z), (a-z), (0-9), underscores (_), and hyphen (-) are allowed for filenames. Spaces are not allowed. Please rename before uploading.</li>
                                </ul>
                            </div>

                            <label for="input-25">Sale Listing</label>
                            <div class="file-loading">
                                <input asp-for="FileUploadList.Files"
                                       type="file"
                                       class="file"
                                       multiple
                                       data-show-upload="false"
                                       data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                       accept="application/all"
                                       data-show-caption="true"
                                       data-msg-placeholder="Select {files} for upload...">
                                @* onchange="fileChange(this)" *@

                            </div>
                        </div>

                    </div>
                </div>
                <hr />
                <div class="row d-flex justify-content-center m-0">
                    <div class="col-md-12">
                        <h5 class="text-secondary">Please match your uploaded file based on the Document Type for Sale Listing.<span class="s-required">*</span></h5>
                        <table class="table dataTable" id="tblApplicantFiles">
                            <thead>
                                <tr>
                                    <th style="width: 30%">
                                        Required Document
                                    </th>
                                    <th>
                                        Uploaded Document
                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 0;
                                }
                                @foreach (DocumentType item in Model.DocumentTypeList)
                                {
                                    <tr>
                                        <td style="width: 30%">
                                            @Html.DisplayFor(modelItem => item.Description)<span class="s-required">*</span>
                                        </td>
                                        <input type="hidden"
                                               asp-for="CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].DocumentTypeId"
                                               value="@item.Id" />
                                        <td>
                                            <select class="form-select fileListDropDown"
                                                    id="fileListDropDown_@i"
                                                    data-prevVal=""
                                                    data-curVal=""
                                                    onchange="fileSelected(this)"
                                                    asp-for="CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].FileNames"
                                                    multiple required>
                                            </select>
                                        </td>
                                        @{
                                            i++;
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="form-group d-flex justify-content-center gap-4">
                <button type="button" id="prevBtn" class="btn btn-secondary scroll-top w-25" onclick="nextPrev(-1)">Back</button>
                <button type="button" id="nextBtn" class="btn btn-primary w-25 btn-next scroll-top" onclick="nextPrev(1)">Next</button>
                <button type="button" id="btnSubmit" class="btn btn-primary w-25 btn-submit scroll-top">Submit</button>
            </div>

        </div>
    </form>


</div>

<script type="text/javascript">

    $(document).ready(function () {
        // debugger;
        const saleListingForm = document.getElementById('SaleListingForm');
        $("#btnSubmit").click(function () {
            //Check if required fields are filled up
            if ($("#SaleListingForm")[0].checkValidity()) {
                debugger;
                var formFiles = document.forms['SaleListingForm']['FileUploadList.Files'];

                var x = document.forms['SaleListingForm']['Dataxxx'];

                x.value = JSON.stringify(applications);

                if (formFiles.files.length == 0) {
                    Swal.fire({
                        title: "No File Selected",
                        text: "Please upload the required documents to proceed with the application.",
                        icon: "error",
                        confirmButtonColor: '#14984a'
                    });
                } else {
                    debugger;
                    $("#confirmSubmitModal").modal("show");
                    // saleListingForm.submit();
                    // $("#confirmSubmitModal").modal("hide");
                }
            }
            //If fields are not filled up
            else {
                // debugger;
                //Validate Form
                $("#SaleListingForm")[0].reportValidity();

            }

        });


        let applications = [

        ];

        // Function to update application data inline
        $(document).on('blur', '.editable', function () {
            let id = $(this).data('id');
            let field = $(this).data('field');
            let newValue = $(this).text();
            updateApplication(id, field, newValue);
        });

        function updateApplication(id, field, newValue) {
            let appIndex = applications.findIndex(app => app.ID === id);
            if (appIndex !== -1) {
                applications[appIndex][field] = newValue;
            }
        }
        $("#backBtn").click(function () {
            $("#confirmSubmitModal").modal("hide");
        });

        $("#btnConfirmSubmit").click(function () {
            debugger;
            $("#confirmSubmitModal").modal("hide");
            saleListingForm.submit();
            // CreateFileUpload();
        });

        $("#finalOKBtn").click(function () {
            $("#confirmSuccessModal").modal("hide");
        });
        //END FOR MODAL FORM SUBMISSION CONFIRMATION
    });


    //Multiple Select
    $('.form-select.fileListDropDown').each(function () {
        // debugger;
        //Initialize Selectize on the select element with the specified class

        var $select = $(this).selectize({
            create: true,
            placeholder: 'Please select your uploaded file',
            plugins: ['remove_button'], // Enable the remove button
        })[0].selectize;


        $('.file').on('change', function (event) {

            //validate


            var files = event.target.files;
            //var formFiles = document.forms['SaleListingForm']['CreateFileUploadList.Files'];

            $select.clear();
            // Clear existing options
            $select.clearOptions();
            $select.addOption({ value: "N/A", text: "N/A" });
            // Loop through each selected file
            for (var i = 0; i < files.length; i++) {
                var file = files[i];

                // Get the file name
                var fileName = file.name;
                //Check if filename contains special characters
                if (fileName.search(/(?:\.(?![^.]+$)|[^\w.-])+/g) >= 0) {
                    Swal.fire({
                        icon: "error",
                        title: "File name not allowed!",
                        text: "Only upload filenames without special characters and spaces. Only alphanumeric characters (A-Z), (a-z), (0-9), underscores (_), and hyphen (-) are allowed ",
                        confirmButtonColor: '#14984a'
                    });
                    const removeFileButton = document.querySelector('.fileinput-remove-button');
                    removeFileButton.click();
                    $select.clear();
                    $select.clearOptions();
                    break;
                }
                else {
                    // Add options based on the file name
                    $select.addOption({ value: fileName, text: fileName });
                }
            }

            // Refresh the Selectize control to update the UI
            //$select.refreshOptions();
        });

        //If files were placed using drag and drop feature
        $(document).on('drop', '.file-drop-zone.clearfix', function () {
            console.log("dropped");
            $select.clear();
            $select.clearOptions();


            var formFiles = document.forms['SaleListingForm']['FileUploadList.Files'];
            var files = formFiles.files;

            $select.addOption({ value: "N/A", text: "N/A" });
            // Loop through each selected file
            for (var i = 0; i < files.length; i++) {
                var file = files[i];

                // Get the file name
                var fileName = file.name;
                //Check if filename contains special characters
                if (fileName.search(/(?:\.(?![^.]+$)|[^\w.-])+/g) >= 0) {
                    Swal.fire({
                        icon: "error",
                        title: "File name not allowed!",
                        text: "Only upload filenames without special characters and spaces. Only alphanumeric characters (A-Z), (a-z), (0-9), underscores (_), and hyphen (-) are allowed ",
                        confirmButtonColor: '#14984a'
                    });
                    const removeFileButton = document.querySelector('.fileinput-remove-button');
                    removeFileButton.click();
                    $select.clear();
                    $select.clearOptions();
                    break;
                }
                else {
                    // Add options based on the file name
                    $select.addOption({ value: fileName, text: fileName });
                }
            }

        });

        //If remove button of files will be clicked
        $(document).on('click', '.fileinput-remove-button', function () {
            console.log("remove button clicked");
            $select.clear();
            $select.clearOptions();
        });
    });

    //End of Multiple Select
    //FOR CHECKLIST OF DOCUMENTS
    function fileChange(that) {
        // debugger;
        var formFiles = document.forms['SaleListingForm']['FileUploadList.Files'];
        PopulateFileDropDown(".fileListDropDown", formFiles.files);
    }

    function PopulateFileDropDown(fileDropDownClass, list) {

        $(fileDropDownClass).empty();
        $(fileDropDownClass).append("<option value=\"\" selected disabled>--Please select your uploaded file--</option>")
        $(fileDropDownClass).append("<option value=\"N/A\" >N/A</option>")
        $.each(list, function (index, row) {
            $(fileDropDownClass).append("<option value=\"" + row.name + "\"id=\"uploadedFile_" + index + "\">" + row.name + "</option>")
        });
    }

    function fileSelected(that) {
        debugger;
        var curval = that.dataset.curval;
        var id = that.id;
        document.getElementById(that.id).setAttribute("data-prevVal", curval);
        document.getElementById(that.id).setAttribute("data-curVal", that.value);
    }
    //END FOR CHECKLIST OF DOCUMENTS

    function CreateFileUpload() {
        debugger;
        var viewModel = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model))';
        // viewModel = JSON.parse(viewModel);
        let parameters = { viewModel: viewModel };
        $.ajax({
            url: '/SaleListing/Create/',
            type: 'POST',
            data: JSON.stringify(parameters),
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            success: function (data) {
                // NOTE: TO DO better way of calling callback function from parent
                CloseModal();
                // Swal.fire({
                //     title: "Success!",
                //     icon: "success",
                //     confirmButtonText: "Ok",
                //     confirmButtonColor: '#14984a'
                // });
                window.location.reload()
                // $('#ListPartialContainer').load('/SaleListing/ListPartialView');

            },

            error: function (e) {
                debugger;
                console.log("error in ajax call salelisting/create" + e);
            }
        });
    }

    var currentTab = 0;
    showTab(currentTab);

    function showTab(n) {
        $(".form-submit-tab").hide();
        $(".form-submit-tab").eq(n).show();

        $(".form-submit-step").removeClass("active");

        switch (n) {
            case 0:
                $(".form-submit-step").eq(0).addClass("active");
                $(".btn-next").show();
                $(".btn-submit").hide();
                break;
            case 1:
                $(".form-submit-step").eq(1).addClass("active");
                $(".btn-next").hide();
                $(".btn-submit").show();
                break;
        }

        $("#prevBtn").toggle(n !== 0);
    }
    function nextPrev(n) {
        var x = $(".form-submit-tab");

        x.eq(currentTab).hide();
        currentTab += n;

        if (currentTab >= x.length) {
            $(".form-submit-step").removeClass("active");
            $(".form-submit-step").eq(3).addClass("active");
            return false;
        }

        showTab(currentTab);
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

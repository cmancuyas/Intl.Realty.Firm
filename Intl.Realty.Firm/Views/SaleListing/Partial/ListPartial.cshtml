@using Intl.Realty.Firm.Models.Models.ViewModel.SaleListingVM
@model SaleListingListViewModel

<div>

    <div class="row">
        <div class="col-md-12 d-flex justify-content-md-between align-items-center">
            <h1 class="text-blue mb-0">Sales Listing</h1>
            <div class="d-flex gap-4">
                <a id="btnMultipleDelete"
                   class="btn btn-danger d-none align-items-center px-4"
                   data-toggle="tooltip"
                   data-bs-placement="left"
                   title="Delete"
                   onclick="OpenMultipleDeleteModal()">
                    <i data-feather="trash-2"></i> Delete
                </a>

                <a asp-action="Create"
                   class="btn btn-primary d-flex align-items-center">
                    <i data-feather="plus" class="w-15px h-auto me-1"></i>Add New
                </a>
            </div>
        </div>
    </div>
    <form id="ListFormId" method="post">
        <table id="modelTable" class="data-table table-striped table table-hover mt-4 w-100">
            <thead>
                <tr>
                    <th class="text-lg-start">
                        <input type="checkbox" class="column-checkbox" data-toggle="tooltip" data-bs-placement="left" title="Select all">
                    </th>
                    <th class="text-lg-start">
                        Deal ID
                    </th>
                    <th class="text-lg-start">
                        Property Address
                    </th>
                    <th class="text-lg-start">
                        Deal Status
                    </th>
                    <th class="text-lg-start">
                        Created At
                    </th>
                    <th class="text-lg-start">
                        Created By
                    </th>
                    <th class="text-lg-start">
                        Action
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SaleListingsViewModel!)
                {
                    <tr data-SaleListing-id="@item.Id">
                        <input type="hidden" name="id" id="id" />
                        <td class="text-lg-start">
                            <input type="checkbox" class="row-checkbox" name="selectedRows" id="selectedRows" value="@item.Id" />
                        </td>
                        <td class="text-lg-start">
                            @Html.DisplayFor(modelItem => @item.Id)
                        </td>
                        <td class="text-lg-start">
                            @if (Model != null && !String.IsNullOrEmpty(@item.IRFDeal?.PropertyAddress))
                            {
                                @Html.DisplayFor(modelItem => @item.IRFDeal.PropertyAddress)
                            }
                        </td>
                        <td class="text-lg-start">
                            @Html.DisplayFor(modelItem => @item.DealStatus!.Description)
                        </td>
                        <td class="text-lg-start">
                            @Html.DisplayFor(modelItem => @item.CreatedAt)
                        </td>
                        <td class="text-lg-start">
                            @{
                                var user = Model.Users.Where(x => x.Id == item.CreatedBy).FirstOrDefault();
                                var fullName = user.FirstName + " " + user.LastName;
                            }
                            @fullName
                        </td>
                        <td class="text-lg-start">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary" data-position-id="@item.Id">
                                Edit
                            </a>
                            <button id="btnChangeStatus" type="button" onclick="openChangeStatusModal(@item.Id)"class="btn btn-secondary" data-position-id="@item.Id">
                                Change Status
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        feather.replace();
        $('[data-toggle="tooltip"]').tooltip();

        DataTableSettings();

        SearchBoxSettings();

        CheckboxSelect();

        MultipleDelete();

        OpenDealStatusModal();

        $("#cancelBtn").click(function () {
            CloseModal();
        });

        handleToastrNotification('addSuccess', 'New SaleListing added successfully!');
        handleToastrNotification('editSuccess', 'SaleListing updated successfully!');
        handleToastrNotification('deleteSuccess', 'SaleListing deleted successfully!');
    }); // document.ready();

    function openChangeStatusModal() {

    }

    function DataTableSettings(){
        $('.data-table').DataTable({
            columnDefs: [
                { targets: [0], orderable: false },
                { targets: [1, 2], orderable: true },
            ],
            order: [[1, 'asc']]
        });
    }

    function SearchBoxSettings(){
        $('[id^=dt-search]').attr('placeholder', 'Search...').addClass('fst-italic');
    }

    function MultipleDelete() {
        $('#modelTable').on('change', '.row-checkbox, .column-checkbox', function () {
            var atLeastOneChecked = $('.row-checkbox:checked').length > 0;
            $('#btnMultipleDelete').toggleClass('d-none', !atLeastOneChecked);
            $('#btnMultipleDelete').toggleClass('d-flex', atLeastOneChecked);

            if ($(this).hasClass('column-checkbox')) {
                var isChecked = $(this).prop('checked');
                $('.row-checkbox').prop('checked', isChecked);
            }
        });

        $('#btnConfirmDelete').click(function () {
            $('#deleteConfirmModal').modal('hide');
            window.location.href = window.location.href.split('?')[0] + '?deleteSuccess=true';
        });
    }

    function CheckboxSelect(){
        $('.column-checkbox').change(function () {
            var isChecked = $(this).prop('checked');
            $('.row-checkbox').prop('checked', isChecked);
        });

        $('#modelTable').on('change', '.column-checkbox', function () {
            var isChecked = $(this).prop('checked');
            $('.row-checkbox').prop('checked', isChecked);

        });

        $('#modelTable').on('change', '.row-checkbox', function () {
            var isChecked = $(this).prop('checked');

            var allChecked = $('.row-checkbox').length === $('.row-checkbox:checked').length;
            $('.column-checkbox').prop('checked', allChecked);

        });

        $('.row-checkbox').change(function () {
            var allChecked = $('.row-checkbox').length === $('.row-checkbox:checked').length;
            $('.column-checkbox').prop('checked', allChecked);
        });
    }

    function CloseModal() {
        $("#deleteConfirmModal").modal("hide");
        let elem = document.querySelector('#deleteConfirmModal');
        elem.parentNode.removeChild(elem);
    }

    function OpenMultipleDeleteModal() {
        var selectedRows = getSelectedRows();
        var selectedIdsArray = getIdsFromSelectedRows(selectedRows);

        var allChecked = $('.row-checkbox').length === $('.row-checkbox:checked').length;
        $('.column-checkbox').prop('checked', allChecked);

        $('#DeleteMultipleModalContainer').load('/SaleListing/DeleteMultipleModal/', { ids: selectedIdsArray }, function () {
            $("#deleteConfirmModal").modal("show");
        });
    }

    function getIdsFromSelectedRows(selectedRows) {
        var ids = [];
        for (var i = 0; i < selectedRows.length; ++i)
            ids.push(selectedRows[i].value);
        return ids;
    }
    function OpenCreateModal() {
        $('#CreateModalContainer').load('/SaleListing/CreateModal/', function () {
            $("#createModal").modal("show");
        });
    }
    function OpenEditModal(id) {
        $('#EditModalContainer').load('/SaleListing/EditModal/' + id, function () {
            $("#editModal").modal("show");
        });
    }
    function OpenDeleteModal(id) {

        $('#DeleteModalContainer').load('/SaleListing/DeleteModal/' + id, function () {

            $("#deleteConfirmModal").modal("show");
        });
    }
    function ClearSearch() {
        $("#dt-search-0").val("").keyup();
    }

    function getSelectedRows() {
        var table = $('#modelTable').dataTable();
        selectedRows = table.find('input[name="selectedRows"]:checked').serializeArray();

        return selectedRows;
    }
</script>
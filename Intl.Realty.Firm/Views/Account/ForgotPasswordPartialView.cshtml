@using Intl.Realty.Firm.Models.Models.ViewModel.AccountVM

@model AccountViewModel

@Html.AntiForgeryToken()
@Html.HiddenFor(m => m.IsValidUsername)
@Html.HiddenFor(m => m.IsValidPassword)
<form asp-action="ForgotPasswordValidateUsername" method="post">
		<div class="modal fade" id="forgotPassword" aria-labelledby="forgotPasswordLabel" aria-hidden="true" role="dialog">
		<div class="modal-dialog">
			<div class="modal-content forgot-pass-modal-content">
				<div class="modal-header forgot-pass-modal-header">
					<h5 class="modal-title forgot-pass-modal-title">Forgot Password?</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="form-group mb-3">
						<p class="mb-0">Please enter your email associated with your account to reset your password</p>
						<label class="fw-bolder mt-4 mb-1" for="username">Email Address</label>
						<input asp-for="ResetPasswordViewModel.Username" placeholder="example@AppDomain.com" class="form-control" />
						<span asp-validation-for="ResetPasswordViewModel.Username" class="text-danger small fst-italic"></span>
					</div>
				</div>
				<div class="modal-footer forgot-pass-modal-footer mb-3">
					<button type="submit" class="btn btn-primary w-100">Submit</button>
				</div>
			</div>
		</div>
	</div>
</form>

<!--Success modal-->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-body d-flex flex-column align-items-center py-5">
				<div class="text-white bg-blue p-4 rounded-circle border-icon">
					<i data-feather="check" width="100" height="100"></i>
				</div>
				<h2 class="text-black fw-bolder pt-3">Please check your email.</h2>
			</div>
			<div class="d-flex justify-content-center mb-5">
				<button type="button" class="btn btn-primary w-25" data-bs-dismiss="modal">Confirm</button>
			</div>
		</div>
	</div>
</div>
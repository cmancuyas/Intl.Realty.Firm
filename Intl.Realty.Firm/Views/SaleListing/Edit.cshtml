                                <span asp-validation-for="EditIRFDealViewModel.ListingAgentName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="EditIRFDealViewModel.ListingBrokerage" class="control-label"></label>
                                <input asp-for="EditIRFDealViewModel.ListingBrokerage" class="form-control" />
                                <span asp-validation-for="EditIRFDealViewModel.ListingBrokerage" class="text-danger"></span>
                            </div>

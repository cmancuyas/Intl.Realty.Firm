@using Intl.Realty.Firm.Models.Models
@using Intl.Realty.Firm.Models.Models.ViewModel.SaleListingVM
@model EditSaleListingViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="mb-5">
    <a href="@Url.Action("Index","SaleListing")" class="text-decoration-none text-blue d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8 card p-4">
            <h1 class="text-blue mb-0">Edit SaleListing</h1>
            <hr class="my-4" />
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <table>
                    <tr>
                        <th>File Name</th>
                        <th></th>
                    </tr>
                    @{
                        @if (Model.FileUploads != null)
                        {
                            @foreach (var file in Model.FileUploads)
                            {
                                <tr>
                                    <td>@file.DocumentType.Description</td>
                                    <td>@Html.ActionLink(file.OriginalFileName, "DownloadFile", new { filePath = file.FilePath, fileName = file.OriginalFileName })</td>
                                </tr>
                            }
                        }
                    }
                </table>

                <hr class="my-5" />
                <div class="form-group d-flex justify-content-center gap-4">
                    <input type="button" value="Cancel" class="btn btn-secondary w-15" onclick="window.location.href='@Url.Action("Index", "SaleListing")'" />
                    <input type="submit" value="Save" class="btn btn-primary w-15" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            $('#isActiveCheckbox').on('click', toggleStatusLabels);

            toggleStatusLabels();
        });

        function toggleStatusLabels() {
            if ($('#isActiveCheckbox').is(':checked')) {
                $('#lblStatus').css('color', '#0d6efd').text("Active");
            } else {
                $('#lblStatus').css('color', '#bfbfbf').text("Inactive");
            }
        }
    </script>
}